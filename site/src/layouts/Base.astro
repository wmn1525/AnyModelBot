---
// 全站样式：token、基础、共用组件、Eyes 标记。各页自己的版式在 views/* 里引入（home / pricing / pages.css）；
// 机器人头像（bots.css）随 BotFace 组件、演示导览（tour.css）随 DemoTour 组件、顶部公告条（banner.css）随 SiteBanner 加载。
import "../styles/base.css";
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/eyes.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SiteBanner from "../components/SiteBanner.astro";
import { dict, href, READY_LANGS, LOCALES, type Lang } from "../i18n";
import { ORIGIN, ANALYTICS_SCRIPT_URL, ANALYTICS_SITE_ID, releases, GITHUB_URL } from "../lib/site";

interface Props {
  lang: Lang;
  /** 不带语言前缀的路径，如 "/"、"/pricing" */
  path: string;
  title?: string;
  description?: string;
  jsonLd?: object[];
  noindex?: boolean;
  /** 分享卡片的标题和描述，不传就用 title、description。卡片文案要和搜索结果不一样时才传 */
  ogTitle?: string;
  ogDescription?: string;
  /** 分享图，url 写完整地址。不传就用当前语言的默认图（1200×630） */
  ogImage?: { url: string; width: number; height: number };
  /** 方图要配 summary，默认的大图卡片会把它裁掉一截 */
  twitterCard?: "summary" | "summary_large_image";
}
const { lang, path, title, description, jsonLd = [], noindex = false, ogTitle, ogDescription, ogImage, twitterCard = "summary_large_image" } = Astro.props;
const t = dict(lang);
const pageTitle = title ?? t.meta.title;
const desc = description ?? t.meta.description;
const cardTitle = ogTitle ?? pageTitle;
const cardDesc = ogDescription ?? desc;
const canonical = `${ORIGIN}${href(lang, path)}`;
const og = ogImage ?? { url: `${ORIGIN}${t.meta.ogImage}`, width: 1200, height: 630 };
const dlData = {
  version: releases.version,
  publishedAt: releases.publishedAt,
  platforms: Object.fromEntries(Object.entries(releases.platforms).filter(([k]) => k !== "docker")),
  docker: releases.platforms.docker.command,
  github: `${GITHUB_URL}/releases`,
  i18n: {
    win: t.download.win, mac: t.download.mac, linux: t.download.linux, mobile: t.download.mobile, generic: t.download.generic,
    downloading: t.download.downloading, started: t.download.started, copied: t.ui.copied, copyFailed: t.ui.copyFailed,
    bannerLeft: t.banner.left, bannerLastDay: t.banner.lastDay,
  },
  lang,
};
---
<!doctype html>
<html lang={t.meta.lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {ORIGIN && <link rel="canonical" href={canonical} />}
    {ORIGIN && !noindex && READY_LANGS.map((l) => <link rel="alternate" hreflang={LOCALES[l].tag} href={`${ORIGIN}${href(l, path)}`} />)}
    {ORIGIN && !noindex && <link rel="alternate" hreflang="x-default" href={`${ORIGIN}${href("zh", path)}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="okbot" />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={cardDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og.url} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:locale" content={LOCALES[lang].og} />
    {READY_LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALES[l].og} />)}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={cardTitle} />
    <meta name="twitter:description" content={cardDesc} />
    <meta name="twitter:image" content={og.url} />
    <meta name="theme-color" content="#060706" data-theme-color />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement, pref = "dark";
        try { pref = localStorage.getItem("amb-theme") || "dark"; } catch (e) {}
        var dark = pref === "system" ? matchMedia("(prefers-color-scheme: dark)").matches : pref !== "light";
        d.dataset.theme = dark ? "dark" : "light";
        d.dataset.themePref = pref;
        d.classList.add("js");
        var tc = document.querySelector("meta[data-theme-color]");
        if (tc) tc.setAttribute("content", dark ? "#060706" : "#f4f5f7");
      })();
    </script>
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    {import.meta.env.PROD && ANALYTICS_SCRIPT_URL && <script is:inline defer src={ANALYTICS_SCRIPT_URL} data-website-id={ANALYTICS_SITE_ID} data-do-not-track="true"></script>}
    <script type="application/json" id="amb-data" set:html={JSON.stringify(dlData)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <SiteBanner lang={lang} path={path} />
    <Nav lang={lang} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
    <div class="toasts" role="status" aria-live="polite" data-toasts></div>
    <script>
      import "../scripts/client";
    </script>
  </body>
</html>
