---
// 首页"看演示"：弹窗播放真实录屏，每种语言各一个（public/demo/demo-<语言>.mp4，构建时从 docs/assets/demo/ 同步）。
// preload="none"：不点就不下载。视频没有音轨，字幕烧在画面里。点开就播、关掉就停，逻辑在 scripts/sections.ts。
import "../styles/demo-video.css";
import Icon from "./Icon.astro";
import { dict, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
---
<dialog class="sheet demo-video" id="demo-video" aria-labelledby="demo-video-title">
  <div class="sheet__head">
    <h2 class="h3" id="demo-video-title">{t.home.tour.title}</h2>
    <button class="icon-btn" type="button" data-close-dialog aria-label={t.ui.close}><Icon name="close" /></button>
  </div>
  <div class="sheet__body">
    <video class="demo-video__player" src={`/demo/demo-${lang}.mp4`} controls muted playsinline preload="none" aria-labelledby="demo-video-title"></video>
  </div>
</dialog>
