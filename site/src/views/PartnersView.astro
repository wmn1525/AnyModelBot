---
import Base from "../layouts/Base.astro";
import { brandCopy } from "../data/brand-copy";
import { CONTACT_URL, MF } from "../lib/site";
import type { Lang } from "../i18n";
import "../styles/pages.css";
interface Props { lang: Lang; largeCard?: boolean }
const { lang } = Astro.props;
const c = brandCopy[lang];
---
<Base lang={lang} path="/partners" title={c.partnerTitle} description={c.partnerLead}>
  <article class="container page prose">
    <header class="page__head"><h1>{c.partnerTitle}</h1><p class="lead">{c.partnerLead}</p></header>
    <p>{c.contact}</p>
    <p class="page__cta"><a class="btn btn--primary" href={MF.home(lang)} target="_blank" rel="noopener">{c.register} ↗</a></p>
    <p><a href={CONTACT_URL} target="_blank" rel="noopener">{c.issues} ↗</a></p>
  </article>
</Base>
