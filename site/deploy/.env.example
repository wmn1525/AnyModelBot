# 官网部署值（docker compose --env-file deploy/.env）
SITE_DOMAIN=
GITHUB_URL=https://github.com/wmn1525/AnyModelBot
SECURITY_EMAIL=
# 自托管 Umami（可选；留空则不加载统计脚本）
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=
# 应用的 Docker 镜像（页面上的 docker run 命令用它）；留空则显示"从源码构建"的命令
DOCKER_IMAGE=ghcr.io/wmn1525/okbot
# 可选：GitHub API 令牌。下载数据每天从 GITHUB_URL 的最新 Release 读一次，匿名请求就够
GITHUB_TOKEN=
# 目录 Bot 的产物目录（amb-bot pack 的输出），对外地址是 /catalog/；留空则用 deploy/catalog
CATALOG_DIR=
# 宿主机端口（绑定 0.0.0.0，可通过服务器 IP 直接访问，也可由 Caddy 反代）
SITE_PORT=18490
# production：部署值缺失时构建失败、继续用上一版；draft：先跑起来，页面上留占位符
SITE_BUILD=production
